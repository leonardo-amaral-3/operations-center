{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",

    // A exceção nominal do renderer, e ela é nominal de propósito: `src/renderer/**` inteiro não
    // cabe neste programa (não há `lib: DOM` aqui), mas o estado da sessão e a regra que o move são
    // puros e precisam ser legíveis pelo teste, que roda no programa do Node. Mesmo arranjo do
    // `src/shared/`: listado nos dois, e por isso um só. Se a lista crescer, o sinal é que a parte
    // pura virou pasta — e aí ela vira glob, não uma segunda linha.
    "src/renderer/session/sessionView.ts",

    "tests/**/*.ts"
  ]
}
